# 시온바나나 로컬 도구 설정
# 모든 항목은 선택. 비워두면 기본값을 사용한다.

# 데이터 디렉토리 (이미지 PNG, SQLite 등). 비워두면 ./data
SIONBANANA_DATA_DIR=

# Codex 인증 파일이 위치한 디렉토리. 비워두면 다음 순서로 자동 탐색:
# $CHATGPT_LOCAL_HOME/auth.json → $CODEX_HOME/auth.json
# → ~/.chatgpt-local/auth.json → ~/.codex/auth.json
CHATGPT_LOCAL_HOME=
CODEX_HOME=

# Codex Responses 엔드포인트 (보통 변경 불필요)
# 기본값: https://chatgpt.com/backend-api/codex/responses
CODEX_RESPONSES_ENDPOINT=

# 기본 모델 (요금제별로 노출되는 모델이 다를 수 있음)
DEFAULT_TEXT_MODEL=gpt-5.5
DEFAULT_IMAGE_MODEL=gpt-5.5
