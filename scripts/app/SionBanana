#!/usr/bin/env bash

set -u

HEALTH="http://localhost:3002/api/health"
STUDIO="http://localhost:3002/studio"
JOB_LABEL="com.sionbanana.server"
USER_DOMAIN="gui/501"
STOP_FLAG="$HOME/Library/Application Support/SionBanana/server-stopped"
APP_LOG="$HOME/Library/Logs/SionBanana/app.log"

/bin/mkdir -p "$(/usr/bin/dirname "$APP_LOG")"
log_app() { printf '%s %s\n' "$(/bin/date '+%F %T')" "$1" >>"$APP_LOG"; }

log_app "start"

health_ok() {
  /usr/bin/curl -fsS -m 2 "$HEALTH" >/dev/null 2>&1
}

notify_startup_failure() {
  /usr/bin/osascript -e 'display notification "서버 기동 실패 — ~/Library/Logs/SionBanana/server.log 확인" with title "SionBanana"' >/dev/null 2>&1 || true
}

/bin/rm -f "$STOP_FLAG"
log_app "stop flag removed: $STOP_FLAG"

if ! health_ok; then
  log_app "health not ok; kickstart"
  /bin/launchctl kickstart "${USER_DOMAIN}/${JOB_LABEL}" >/dev/null 2>&1 || true

  ready=0
  for _ in {1..45}; do
    /bin/sleep 2
    if health_ok; then
      ready=1
      break
    fi
  done

  if [ "$ready" -ne 1 ]; then
    notify_startup_failure
    exit 1
  fi
else
  log_app "health ok"
fi

if [ -d "/Applications/Google Chrome.app" ]; then
  focus_existing_studio_window() {
    /usr/bin/osascript <<'APPLESCRIPT' >/dev/null 2>&1
set targetUrl to "localhost:3002/studio"
tell application "Google Chrome"
  repeat with chromeWindow in windows
    try
      if (URL of active tab of chromeWindow) contains targetUrl then
        set index of chromeWindow to 1
        activate
        return
      end if
    end try
  end repeat
end tell
error "SionBanana Studio window not found"
APPLESCRIPT
  }

  focus_existing_studio_window || /usr/bin/open -na "Google Chrome" --args --app="$STUDIO"
else
  /usr/bin/open "$STUDIO"
fi
log_app "window open/focus"

exit 0
